@model IEnumerable<RaceDay.Web.Models.EventDto>
@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <h2 class="fw-bold" style="color: #1E293B;">Manage Events</h2>
    <a asp-action="CreateEvent" class="btn btn-primary-custom btn-lg fw-bold">
        <i class="bi bi-plus-lg"></i> Create New Event
    </a>
</div>

@if (!Model.Any())
{
    <div class="card card-custom p-5 text-center">
        <h4 class="text-muted mb-4">No events found in the system.</h4>
        <div>
            <a asp-action="CreateEvent" class="btn btn-primary-custom">Create Your First Event</a>
        </div>
    </div>
}
else
{
    <div class="row">
        @foreach (var ev in Model)
        {
            <div class="col-md-6 mb-4">
                <div class="card card-custom p-4 h-100">
                    <div class="d-flex justify-content-between">
                        <h4 class="fw-bold text-truncate" style="color: #FF5722;">@ev.Name</h4>
                        <span class="badge" style="background-color: #E2E8F0; color: #475569;">@ev.EventType</span>
                    </div>
                    <p class="text-muted mb-4">
                        <i class="bi bi-calendar-event"></i> @ev.EventDate.ToString("dd MMM yyyy") |
                        <i class="bi bi-geo-alt"></i> @ev.Location
                    </p>

                    <div class="mt-auto d-flex flex-column gap-2">
                        <div class="d-flex gap-2">
                            <a asp-action="ManageCategories" asp-route-eventId="@ev.EventID" class="btn btn-outline-warning btn-sm w-50 fw-bold">Categories</a>
                            <a asp-action="ViewEnrolments" asp-route-eventId="@ev.EventID" class="btn btn-outline-info btn-sm w-50 fw-bold">Enrolments</a>
                        </div>

                        <form asp-action="DeleteEvent" asp-route-eventId="@ev.EventID" method="post" onsubmit="return confirm('Are you sure you want to delete this event? This cannot be undone.');">
                            <button type="submit" class="btn btn-outline-danger btn-sm w-100 fw-bold">Delete Event</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}