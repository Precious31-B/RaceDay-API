@using RaceDay.Web.Helpers
@model RaceDay.Web.Models.EventDetailsDto
@{
    ViewData["Title"] = Model.Name;
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card card-custom mb-5 mt-3 overflow-hidden">
    @if (!string.IsNullOrEmpty(Model.BannerImage))
    {
        <img src="@Model.BannerImage" class="card-img-top" alt="@Model.Name" style="max-height: 400px; object-fit: cover;" onerror="this.style.display='none';">
    }
    <div class="card-body p-5">
        <div class="d-flex justify-content-between align-items-start mb-3">
            <h1 class="display-5 fw-bold" style="color: #1E293B;">@Model.Name</h1>
            <span class="badge fs-5" style="background-color: #FF5722;">@Model.EventType</span>
        </div>

        <h5 class="text-muted mb-4">
            <i class="bi bi-calendar-event" style="color: #FF5722;"></i> @Model.EventDate.ToString("dddd, dd MMMM yyyy - HH:mm") <br />
            <i class="bi bi-geo-alt" style="color: #FF5722;"></i> @Model.Location <br />
            <i class="bi bi-signpost" style="color: #FF5722;"></i> @Model.Distance km
        </h5>

        <p class="lead text-muted">@Model.Description</p>
    </div>
</div>

<h3 class="fw-bold mb-4" style="color: #1E293B;">Available Categories</h3>

@if (Context.Session.GetString("MvcUserRole") == "Participant")
{
    <div class="row">
        @foreach (var cat in Model.Categories)
        {
            <div class="col-md-4 mb-4">
                <div class="card card-custom h-100 p-4">
                    <h5 class="fw-bold" style="color: #FF5722;">@cat.Name</h5>
                    <p class="text-muted small mb-3">@cat.Description</p>

                    <div class="d-flex justify-content-between mb-4">
                        <span class="text-muted"><strong>Age:</strong> @(cat.MinAge.HasValue ? $"{cat.MinAge}-{cat.MaxAge}" : "Open")</span>
                        <span class="fw-bold" style="color: #1E293B;">R @cat.EntryFee?.ToString("0.00")</span>
                    </div>

                    <form asp-action="Enrol" method="post" class="mt-auto">
                        <input type="hidden" name="eventId" value="@Model.EventID" />
                        <input type="hidden" name="categoryId" value="@cat.CategoryID" />
                        <button type="submit" class="btn btn-primary-custom w-100">Enrol Now</button>
                    </form>
                </div>
            </div>
        }
    </div>
}
else if (!Context.Session.IsAuthenticated())
{
    <div class="card card-custom p-4 text-center">
        <h5 class="mb-3 text-muted">Please log in as a Participant to enrol.</h5>
        <div>
            <a asp-controller="Account" asp-action="Login" class="btn btn-primary-custom">Log In</a>
        </div>
    </div>
}
else
{
    <div class="alert alert-info border-0 shadow-sm">
        <i class="bi bi-info-circle-fill"></i> Organisers cannot enrol in events.
    </div>
}
